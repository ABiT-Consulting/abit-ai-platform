+    temp = path.with_name(path.name + '.native-new-' + str(os.getpid()) + '.tmp')
+    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, int(row['mode'], 8))
