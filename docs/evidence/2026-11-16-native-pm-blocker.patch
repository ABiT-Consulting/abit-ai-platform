+def _blocked_pm_predecessor(task):
+    # Actual durable same-Task blocker lineage, never a request-selected source.
+    cursor=task.get('custom_agov_active_run');seen=set()
+    for _ in range(20):
+        if not cursor or cursor in seen:return None
+        seen.add(cursor);started=_lookup('run_started',[task.project,cursor])
+        if not started or started.task!=task.name:return None
+        own=_payload(started)
+        if own.get('task_revision')!=_task_revision(task):return None
+        blocked=_lookup('result',[task.project,cursor,'run.blocked'])
+        if own.get('role')!='project_manager':
+            return started if blocked and blocked.task==task.name else None
+        if not own.get('previous_run_id'):return None
+        cursor=own['previous_run_id']
+    return None
