[Unit]
Description=ABiT Linux ChatGPT Browser Relay watchdog
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mcpdev
Group=mcpdev
WorkingDirectory=/srv/abit-dev-linux
Environment=ABIT_RELAY_ENABLE_WINDOWS_BRIDGE=1
Environment=ABIT_RELAY_WATCHDOG_LOCK_FILE=/srv/abit-dev-linux/relay-runtime/state/watchdog-systemd.lock
ExecStart=/bin/bash /srv/abit-dev-linux/abit-ai/deployment/relay-watchdog.sh
Restart=always
RestartSec=15
NoNewPrivileges=yes
# Xvfb and Chromium share a writable private /tmp while ProtectSystem=strict remains on.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/abit-dev-linux
LimitNOFILE=8192
UMask=0077

[Install]
WantedBy=multi-user.target
