  "title": "Root-reviewed current Core activation binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "observed_utc",
    "gate_epoch",
    "services",
    "protected_processes",
    "configuration_sha256",
    "database_identities",
    "relay_health_policy"
  ],
