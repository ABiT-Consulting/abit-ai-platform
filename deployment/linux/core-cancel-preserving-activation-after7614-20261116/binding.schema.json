          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "policy"
          ],
          "properties": {
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pid",
                "uid",
                "start",
                "argv_sha256",
                "cgroup_sha256"
              ],
              "properties": {
                "pid": {
                  "type": "integer",
                  "minimum": 1
                },
                "uid": {
                  "type": "integer",
                  "minimum": 0
                },
                "start": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "argv_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "cgroup_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "Restart",
                "KillMode",
                "SendSIGKILL",
                "TimeoutStopUSec"
              ],
              "properties": {
                "Restart": {
                  "type": "string",
                  "minLength": 1
                },
                "KillMode": {
                  "type": "string",
                  "minLength": 1
                },
                "SendSIGKILL": {
                  "type": "string",
                  "minLength": 1
                },
                "TimeoutStopUSec": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
