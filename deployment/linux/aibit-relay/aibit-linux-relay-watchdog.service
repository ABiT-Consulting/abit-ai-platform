[Unit]
Description=ABiT Linux ChatGPT Browser Relay watchdog
Documentation=file:/srv/abit-dev-linux/relay-runtime/service/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mcpdev
Group=mcpdev
WorkingDirectory=/srv/abit-dev-linux
ExecStart=/srv/abit-dev-linux/relay-runtime/service/watchdog.sh
Restart=always
RestartSec=15
NoNewPrivileges=yes
PrivateTmp=no
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/abit-dev-linux
LimitNOFILE=8192
UMask=0077

[Install]
WantedBy=multi-user.target
