+                binding["erp_baseline_sha256"], "NATIVE_ADMISSION_CHECKPOINT_CHANGED")
+        db.execute("UPDATE governance_native_verification SET grant_issued_at=?,updated_at=? WHERE invocation_id=?",
+                   (now, now, row["invocation_id"]))
