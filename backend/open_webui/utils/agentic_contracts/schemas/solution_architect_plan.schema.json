{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abit.ai/schemas/solution_architect_plan.schema.json",
  "title": "ABiT Solution Architect SRS to ERP Task Plan",
  "description": "Versioned, project-scoped, non-executable architect output. Runtime authorization and artifact existence must be separately verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "requirements",
    "designs",
    "mockups",
    "tasks",
    "tests",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "srs_version",
        "srs_sha256",
        "source_url",
        "source_activity_revision",
        "agent_binding",
        "run_id",
        "generated_at",
        "state"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^PROJ-[A-Za-z0-9-]+$"
        },
        "srs_version": {
          "type": "string",
          "minLength": 1
        },
        "srs_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://erp\\.abit\\.ai/"
        },
        "source_activity_revision": {
          "type": "string",
          "minLength": 1
        },
        "agent_binding": {
          "$ref": "#/$defs/agentBinding"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "const": "proposed"
        },
        "project_backlog_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project_backlog_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "designs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/design"
      }
    },
    "mockups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mockup"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qaTest"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "agentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "erp_ai_user",
        "abit_agent_id",
        "role"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^PROJ-[A-Za-z0-9-]+$"
        },
        "erp_ai_user": {
          "type": "string",
          "minLength": 1
        },
        "abit_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "solution_architect"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "erp_file",
            "repo",
            "content_store"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(erp-file:|repo:|artifact:)[A-Za-z0-9_./:@-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "kind",
        "status",
        "acceptance_criteria",
        "assumptions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[A-Za-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ui",
            "api",
            "data",
            "integration",
            "infrastructure",
            "operations",
            "security",
            "documentation"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "needs_decision"
          ]
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "requirement_ids",
        "summary",
        "artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DES-[A-Za-z0-9-]+$"
        },
        "kind": {
          "enum": [
            "component",
            "sequence",
            "deployment",
            "data",
            "api",
            "security",
            "ui"
          ]
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{2,70}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "mockup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_ids",
        "screen_name",
        "form_factors",
        "states",
        "artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MOCK-[A-Za-z0-9-]+$"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{2,70}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "screen_name": {
          "type": "string",
          "minLength": 1
        },
        "form_factors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "desktop",
              "tablet",
              "mobile"
            ]
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "default",
              "loading",
              "empty",
              "error",
              "success",
              "disabled",
              "dark",
              "rtl"
            ]
          }
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "action",
        "output",
        "verification"
      ],
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_key",
        "subject",
        "description",
        "role",
        "requirement_ids",
        "parent_task_key",
        "depends_on",
        "steps",
        "acceptance_criteria",
        "qa_test_ids",
        "artifact_ids",
        "estimate_hours",
        "priority",
        "idempotency_key"
      ],
      "properties": {
        "task_key": {
          "type": "string",
          "pattern": "^TASKPLAN-[A-Za-z0-9-]+$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "solution_architect",
            "project_manager",
            "developer",
            "qa",
            "operations",
            "it_manager",
            "release",
            "human"
          ]
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{2,70}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "parent_task_key": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^TASKPLAN-[A-Za-z0-9-]+$"
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{2,70}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "qa_test_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{2,70}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{2,70}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "estimate_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 240
        },
        "human_user": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "existing_task_id": {
          "type": "string",
          "pattern": "^TASK-[A-Za-z0-9-]{1,60}$"
        },
        "existing_task_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "dependentRequired": {
        "existing_task_id": [
          "existing_task_revision"
        ],
        "existing_task_revision": [
          "existing_task_id"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "human"
              }
            }
          },
          "then": {
            "required": [
              "human_user"
            ]
          },
          "else": {
            "not": {
              "required": [
                "human_user"
              ]
            }
          }
        }
      ]
    },
    "qaTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_ids",
        "task_keys",
        "method",
        "expected_result",
        "evidence_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TEST-[A-Za-z0-9-]+$"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{2,70}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "task_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{2,70}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "method": {
          "enum": [
            "unit",
            "integration",
            "e2e",
            "manual",
            "security",
            "performance",
            "accessibility",
            "operational"
          ]
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "evidence_required": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_ids",
        "question",
        "owner",
        "approval_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DEC-[A-Za-z0-9-]+$"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{2,70}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "approval_required": {
          "type": "boolean"
        }
      }
    }
  }
}
