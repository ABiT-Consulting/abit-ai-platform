          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
        },
        "implementation_invocation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
        },
        "implementation_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
        },
        "qa_agent_id": {
          "type": "string",
          "format": "uuid"
        },
        "implementation_agent_id": {
          "type": "string",
          "format": "uuid"
        },
        "qa_result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
