        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "url",
              "sha256",
              "requirement_ids"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
              },
              "kind": {
                "enum": [
                  "test_log",
                  "screenshot",
                  "design",
                  "mockup",
                  "commit",
                  "deployment_receipt",
                  "erp_readback",
                  "checkpoint"
                ]
              },
              "url": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https://erp\\.abit\\.ai/private/files/"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "requirement_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              }
            }
          }
        }
      },
      "description": "Server-derived latest independent QA publication for a journal-only PM coordination turn; never permission to reopen or overwrite the approved feature Task."
    },
    "pm_review_continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_invocation_id",
        "previous_result_sha256",
        "previous_receipt_sha256",
        "generation"
      ],
      "properties": {
        "previous_invocation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
        },
        "previous_result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "previous_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "resume_command_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
        },
        "resume_control_sequence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "dependentRequired": {
        "resume_command_id": [
          "resume_control_sequence"
        ],
        "resume_control_sequence": [
          "resume_command_id"
        ]
      },
      "description": "Server-proven next logical PM review after a published checkpoint; never permission to repeat its submitted original. Blocked checkpoints require fresh human applied control proof."
    }
  }
