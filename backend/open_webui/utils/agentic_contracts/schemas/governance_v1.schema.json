          "$ref": "#/$defs/result"
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id",
            "run_id",
            "task_id",
            "modified",
            "status",
            "durable"
          ],
          "properties": {
            "event_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
            },
            "task_id": {
              "type": "string",
              "pattern": "^TASK-[A-Za-z0-9-]{1,60}$"
            },
            "modified": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "status": {
              "const": "QA APPROVED"
            },
