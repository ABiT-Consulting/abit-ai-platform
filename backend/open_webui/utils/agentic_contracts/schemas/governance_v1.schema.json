    "developer_delivery": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exact Developer code and test evidence claims. Server verifies private bytes; independent QA must verify the actual PR and commit. This is not execution authority.",
      "required": [
        "repository",
        "base_commit",
        "head_commit",
        "pull_request_url",
        "changed_paths",
        "commit_evidence_id",
        "test_runs"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "base_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "head_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "pull_request_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "commit_evidence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
        },
        "test_runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test_ids",
              "command",
              "exit_code",
              "log_evidence_id"
            ],
            "properties": {
              "test_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
                }
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "exit_code": {
                "type": "integer",
                "const": 0
              },
              "log_evidence_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:@+-]{1,160}$"
              }
            }
          }
        }
      }
    },
